<configuration>
  <property name="LOG_DIR" value="logs"/>

  <!-- frontend log -->
  <appender name="FRONTEND_FILE"
            class="ch.qos.logback.core.rolling.RollingFileAppender">
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <fileNamePattern>${LOG_DIR}/frontend/%d{yyyy-MM-dd}.log</fileNamePattern>
      <maxHistory>30</maxHistory>
    </rollingPolicy>
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS,Asia/Tokyo} %-5level %msg%n</pattern>
    </encoder>
  </appender>

  <!-- backend log -->
  <appender name="BACKEND_FILE"
            class="ch.qos.logback.core.rolling.RollingFileAppender">
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <fileNamePattern>${LOG_DIR}/backend/%d{yyyy-MM-dd}.log</fileNamePattern>
      <maxHistory>30</maxHistory>
    </rollingPolicy>
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS,Asia/Tokyo} %-5level %logger - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- frontend logger -->
  <logger name="frontend" level="INFO" additivity="false">
    <appender-ref ref="FRONTEND_FILE"/>
  </logger>

  <!-- root = backend -->
  <root level="INFO">
    <appender-ref ref="BACKEND_FILE"/>
  </root>
</configuration>
